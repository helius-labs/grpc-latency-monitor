# Optional: copy to .env and set your ClickHouse credentials and provider tokens.
# The benchmark loads .env from the working directory automatically.
# Already exported environment variables take precedence over values in .env.
BENCH_CH_USER=replace-with-your-clickhouse-user
BENCH_CH_PASSWORD=replace-with-your-clickhouse-password
# Provider x-tokens, named by token_env in your configuration.
BENCH_PROVIDER_A_TOKEN=replace-with-provider-a-token
# Public Solana mainnet JSON-RPC used only for slot plausibility checks.
BENCH_REFERENCE_RPC_URL=https://api.mainnet.solana.com
